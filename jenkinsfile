pipeline {
    agent {
        docker { image 'python:3.12-slim' }
    }
    options {
        skipDefaultCheckout(true)
    }
    stages {
        stage('checkout'){
            steps {
                checkout scm
                sh 'ls -la'
            }
        }
        stage('build') {
            steps {
                sh 'python -m venv ~/.venv'
                sh 'source .venv/bin/activate'
		sh 'which python'
                sh 'pip install flask waitress pywebview'
            }
        }
    }
}