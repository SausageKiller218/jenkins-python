pipeline {
    agent {
        docker { image 'python:3.12-slim' }
    }
    triggers { 
        pollSCM('*/5 * * * *') 
    }
    options {
        skipDefaultCheckout(true)
    }
    stages {
        stage('checkout'){
            steps {
                checkout scm
                sh 'ls -la'
            }
        }
        stage('build') {
            steps {
                sh 'python -m venv venv'
                sh 'venv/bin/python -V'
                sh 'venv/bin/python -m pip install -r requirements.txt'
            }
        }
        stage('test') {
            steps {
                warnError (message: 'ive errored my lored....') {
                    sh 'venv/bin/python -m pytest tests/ -v --junit-xml=build/reports/report.xml'
                }
            }
            
        }
    }
    post {
        always {
            junit 'build/reports/*.xml'
        }
    }
}